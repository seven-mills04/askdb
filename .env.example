# Copy to ".env" next to docker-compose.yml to override the local defaults.
# In production (Render), set these as environment variables instead. Never commit real values.

# Signs login tokens. At least 32 characters.
ASKDB_JWT_SECRET=

# Encrypts saved database passwords. If this changes, saved connections can no longer be opened.
ASKDB_ENCRYPTION_SECRET=

# Switches on plain-English questions. Free key from https://console.groq.com (starts with gsk_).
ASKDB_AI_API_KEY=

# Optional: another OpenAI-compatible provider, e.g. Google Gemini
# ASKDB_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ASKDB_AI_MODEL=gemini-2.5-flash

# --- Set on the backend in production ---
# ASKDB_DB_URL=jdbc:postgresql://<host>:5432/<database>
# ASKDB_DB_USER=
# ASKDB_DB_PASSWORD=
# ASKDB_CORS_ORIGINS=https://<your-app>.vercel.app
# ASKDB_BLOCK_PRIVATE_HOSTS=true
# ASKDB_DEMO_HOST= / ASKDB_DEMO_PORT= / ASKDB_DEMO_DATABASE= / ASKDB_DEMO_USER= / ASKDB_DEMO_PASSWORD=

# --- Set on the frontend in production (Vercel) ---
# VITE_API_URL=https://<your-backend>.onrender.com
